    {
      "id": "feel-feedback",
      "category": "feel",
      "title": "操作反馈与表现预算",
      "tags": [
        "打击感",
        "震屏",
        "镜头",
        "音效",
        "动画",
        "反馈"
      ],
      "stages": [
        "plan",
        "implement",
        "verify"
      ],
      "kind": "original-recipe",
      "version": "需结合玩法与可访问性测试",
      "source": "project:templates/GDD.md",
      "content": "把一次动作拆成输入响应、状态变化、视觉与声音反馈。先确保响应及时和结果清楚，再尝试停顿、镜头或粒子等表现。参数提供编辑入口；震屏与高强度效果允许降低或关闭。比较同一动作调整前后的关键帧、时间和试玩感受，不能凭单张截图声称打击感改善。",
      "updatedAt": "2026-11-08",
      "verification": {
        "status": "recipe-not-runtime-tested",
        "checkedAt": "2026-11-08",
        "note": "原创方法或工作流约定；不是已通过的游戏体验结论。"
